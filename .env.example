APP_NAME="MERAK POS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://merak-pos.onrender.com

# Base de données (à configurer sur Render)
DB_CONNECTION=pgsql
DB_HOST=dpg-xxx.render.com
DB_PORT=5432
DB_DATABASE=merak_pos
DB_USERNAME=merak_user
DB_PASSWORD=votre_mot_de_passe_render

# Paiements CIB / DAHABIA / Chifaa (mode sandbox par défaut)
# Remplissez avec vos vraies clés API quand vous les aurez
CIB_API_KEY=
CIB_API_SECRET=
CIB_API_URL=https://api.cib.dz/sandbox
CIB_MERCHANT_ID=

DAHABIA_API_KEY=
DAHABIA_API_SECRET=
DAHABIA_API_URL=https://api.dahabia.dz/sandbox
DAHABIA_MERCHANT_ID=

CHIF_AA_API_KEY=
CHIF_AA_API_SECRET=
CHIF_AA_API_URL=https://api.chifaa.dz/sandbox
CHIF_AA_MERCHANT_ID=

# Stripe (optionnel)
STRIPE_KEY=
STRIPE_SECRET=

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=database

# Accounting V2
ACCOUNTING_V2_ENABLED=true
ACCOUNTING_V2_AUTO_JOURNALS=true
ACCOUNTING_V2_BASELINE_DATE=2026-04-19